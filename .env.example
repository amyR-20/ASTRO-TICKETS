# --- Servidor ---
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/astro_tickets

# Si prefieres variables sueltas en vez de DATABASE_URL, descomenta y usa:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=astro_tickets
# DB_USER=postgres
# DB_PASSWORD=tu_password

# --- Autenticación ---
# Genera una cadena larga y aleatoria propia.
JWT_SECRET=cambia_esto_por_una_cadena_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# --- Stripe (usa sk_test_ y pk_test_ durante desarrollo) ---
STRIPE_SECRET_KEY=sk_test_reemplaza_esta_clave
STRIPE_PUBLISHABLE_KEY=pk_test_reemplaza_esta_clave
STRIPE_CURRENCY=dop

# --- Correo (reenvío de boletas por email) ---
# SMTP_HOST y SMTP_PASS vacíos = no se envían correos (solo descarga de PDF)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_password_de_app
# SMTP_FROM=Astro Tickets <no-responder@astro.tickets>
